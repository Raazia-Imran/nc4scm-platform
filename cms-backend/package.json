{
  "name": "nc4scm-cms-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed:prepare": "node seed/prepare-client-import.mjs",
    "seed:client": "node seed/import-approved-content.mjs --apply",
    "seed:approved:prepare": "node seed/prepare-approved-content.mjs",
    "seed:approved:preview": "node seed/import-approved-content.mjs",
    "seed:bootstrap": "npm run seed:prepare && sanity dataset import seed/client-content.generated.ndjson production --missing",
    "test:content": "node --test tests/approved-content.test.mjs tests/home-refresh.test.mjs tests/home-story.test.mjs tests/editorial-update.test.mjs tests/october-2026.test.mjs",
    "seed:editorial:preview": "node seed/import-editorial-update.mjs",
    "seed:editorial": "node seed/import-editorial-update.mjs --apply",
    "seed:october:preview": "node seed/import-october-2026-additions.mjs",
    "seed:october": "node seed/import-october-2026-additions.mjs --apply",
    "test:security": "node --test tests/security-compat.test.mjs",
    "audit:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@sanity/client": "7.23.0",
    "@sanity/vision": "6.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.2.7",
    "sanity": "6.21.0",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "groq-js": "1.30.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@oclif/core": {
      "minimatch": "11.0.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "undici@>=7 <8": "7.30.1"
  }
}
